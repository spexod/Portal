[mysqld]
# TLS with the website's Let's Encrypt certificate. MySQL runs as uid 999 and cannot read certbot's
# root-only private key, so it reads a copy in /etc/letsencrypt/mysql-ssl/ made by
# shell/certbot-mysql-hook.sh. After renewals, shell/reload-certs.sh (run by systemd) reloads it.
# See shell/ssl.md.
ssl_cert=/etc/letsencrypt/mysql-ssl/fullchain.pem
ssl_key=/etc/letsencrypt/mysql-ssl/privkey.pem
# intermediate and root certificates that MySQL validates its own certificate against; without them,
# ALTER INSTANCE RELOAD TLS (used after renewals) fails with "Invalid certificates"
ssl_ca=/etc/letsencrypt/mysql-ssl/ca.pem
# reject unencrypted network connections (the local socket is still allowed)
require_secure_transport=ON
loose-container_aware=ON
innodb_redo_log_capacity=1G
