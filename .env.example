### rename this file to .env to configure values for the compose.yaml file (change any passwords to keep them secret).
## global settings
COMPOSE_PROFILES=db,api
MYSQL_USER="root"
MYSQL_PASSWORD="your-password-for-mysql"
## Host for inside the docker network
MYSQL_HOST="mysqlDB"
## Other host examples
## for the production database, use the name on its certificate (not the server's IP address)
# MYSQL_HOST="spexodisks.com"
# MYSQL_HOST="localhost"
## TLS for database connections (optional): VERIFY_IDENTITY is the default for remote hosts,
## REQUIRED for mysqlDB and localhost. See science/db/sql.py.
# MYSQL_SSL_MODE="VERIFY_IDENTITY"
## required for test and upload computers
DATA_NEW_UPLOADS_ONLY=true
## defaults (not required)
# DEBUG=true
# NGINX_CONFIG_FILE="setup.conf"
# API_USE_NEW_TABLES=true
# # a no-profile is the default, multiple profiles can be separated by commas
# COMPOSE_PROFILES=
# COMPOSE_PROFILES=db,web,api
# COMPOSE_PROFILES=ipython
## required for production server
# DATA_MIGRATE_FROM_STAGED=true
# NGINX_CONFIG_FILE="deploy.conf"
# DEBUG=false
# API_USE_NEW_TABLES=false
# DJANGO_SECRET_KEY="some-key-that-is-50-characters-long-and-contains-letters-and-numbers"
# VOLUME_SPECIFICATION="ro"
## deploy.cnf needs the server's Let's Encrypt certificate (see shell/ssl.md), local databases use local.cnf
# MYSQL_CONFIG_FILE="deploy.cnf"
## MySQL server version (default set in compose.yaml).
## Changing the major version upgrades the database files in place, see "MySQL Version Upgrades" in README.md.
# MYSQL_VERSION=9.7